# Status Report Agent - Configuration
# Copy this file to .env and fill in your credentials

# ═══════════════════════════════════════════════════════════════════════════
# SALESFORCE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
SF_INSTANCE_URL=https://your-instance.salesforce.com
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret
SF_USERNAME=your_salesforce_username
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token

# ═══════════════════════════════════════════════════════════════════════════
# SERVICENOW CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
SN_INSTANCE_URL=https://your-instance.service-now.com
SN_USERNAME=your_servicenow_username
SN_PASSWORD=your_servicenow_password
# Optional: OAuth (if using OAuth instead of basic auth)
# SN_CLIENT_ID=your_oauth_client_id
# SN_CLIENT_SECRET=your_oauth_client_secret

# ═══════════════════════════════════════════════════════════════════════════
# LLM CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Provider: "azure" or "openai"
LLM_PROVIDER=azure

# Azure OpenAI (recommended for enterprise)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI Direct (alternative)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o

# ═══════════════════════════════════════════════════════════════════════════
# AGENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Number of days to look back for data
LOOKBACK_DAYS=7

# Role perspective: SDM, PM, or PgM
AGENT_ROLE=SDM

# Output settings
OUTPUT_DIR=./output
OUTPUT_FORMAT=markdown

# Optional: Filter by specific account
# ACCOUNT_FILTER=Acme Corp

# ═══════════════════════════════════════════════════════════════════════════
# DELIVERY CONFIGURATION (Optional)
# ═══════════════════════════════════════════════════════════════════════════
# Email delivery
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# REPORT_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Webex delivery
# WEBEX_ACCESS_TOKEN=your_webex_bot_token
# WEBEX_ROOM_ID=your_webex_room_id
