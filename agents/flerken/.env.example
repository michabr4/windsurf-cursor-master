# ─── Flerken Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── LLM (Ollama — runs locally, no API key needed) ─────────────
# Default: Ollama at localhost. Change these to use OpenAI or Azure OpenAI instead.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# ─── Microsoft Graph (Outlook) ──────────────────────────────────
# Register an app at https://portal.azure.com → Azure Active Directory → App registrations
# Required API permissions: Mail.Read, Mail.Send, User.Read
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_TENANT_ID=your-azure-tenant-id

# ─── Digest Settings ────────────────────────────────────────────
# Your email address (digest will be sent here)
MY_EMAIL=your-email@cisco.com

# How many recent emails to scan (default: 50)
EMAIL_SCAN_COUNT=50

# Hours to look back for emails (default: 24)
LOOKBACK_HOURS=24
