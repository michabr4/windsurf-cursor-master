# Webex Integration
# Get your access token from https://developer.webex.com/docs/getting-started
WEBEX_ACCESS_TOKEN=your_webex_access_token_here
# Optional: Bot token if using a bot
WEBEX_BOT_TOKEN=your_webex_bot_token_here

# Microsoft Graph API (for Outlook/Email)
# Register app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MS_CLIENT_ID=your_azure_app_client_id
MS_CLIENT_SECRET=your_azure_app_client_secret
MS_TENANT_ID=your_azure_tenant_id
MS_USER_EMAIL=michabr4@cisco.com

# OpenAI API (for action extraction)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Alternative: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Agent Configuration
LLM_PROVIDER=openai  # or 'anthropic'
MAX_MESSAGES_PER_ROOM=100
MAX_EMAILS_TO_FETCH=200
LOOKBACK_DAYS=7
RUNTIME_MODE=continuous
RUNTIME_INTERVAL_MINUTES=60
CONTINUOUS_BACKOFF_SECONDS=5

# Output Configuration
OUTPUT_FORMAT=json  # json, csv, markdown
OUTPUT_DIR=./output

# Cisco Domain Detection (for customer vs internal classification)
INTERNAL_DOMAINS=cisco.com,webex.com,ciscospark.com

# Priority Keywords (comma-separated)
HIGH_PRIORITY_KEYWORDS=urgent,asap,critical,escalation,p1,sev1,immediately
MEDIUM_PRIORITY_KEYWORDS=important,soon,this week,follow up,action required
