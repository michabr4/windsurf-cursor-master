# ── MIMIR / Cisco SSO ────────────────────────────────────────────────────────
# Your Cisco SSO username (e.g. jsmith)
MIMIR_USERNAME=your_cisco_username

# SSO cookie cache. "default" = ~/.mimir-cookies-py
# After first interactive auth the cookie is reused for several hours.
MIMIR_COOKIE_FILE=default

# Response cache directory (avoids re-fetching on every run)
MIMIR_CACHE_DIR=/tmp/mimir-cache-np

# Cache TTL in days
MIMIR_CACHE_DAYS=1

# MIMIR base URL (prod by default)
MIMIR_URL=https://mimir-prod.cisco.com

# ── Target company ────────────────────────────────────────────────────────────
# NetProfile cpyKey from the URL: npIndex.do?cpyKey=172361
NP_CPY_KEY=172361

# ── Data extraction controls ─────────────────────────────────────────────────
# CLI commands to run per device (comma-separated list of strings in Python config)
# Configurable in config.py — defaults: show version, show ip interface brief, show clock

# Max devices to query via CLI (0 = all). For large accounts, start with 25-50.
NP_DEVICE_CLI_LIMIT=50

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
LOG_LEVEL=INFO
