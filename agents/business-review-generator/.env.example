# Business Review Generator — environment configuration
HELIX_BASE_URL=https://helix.example.com/api/v1
HELIX_API_TOKEN=your-helix-bearer-token-here

# Salesforce MCP (optional — stub used when unset)
SALESFORCE_MCP_TOKEN=

# Webex notification (optional)
WEBEX_BOT_TOKEN=
WEBEX_ROOM_ID=

# Data runs root (delivery-tracker + business-review output)
DATA_DIR=./data/runs

# LLM (optional — template placeholders used when unset)
LLM_MODEL=
LLM_BASE_URL=

LOG_LEVEL=INFO
