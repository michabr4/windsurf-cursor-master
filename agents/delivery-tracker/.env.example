# ─── Delivery Tracker — environment configuration ──────────────────────────────
# Copy to .env and fill in values. NEVER commit .env to source control.

# ── Helix REST API ─────────────────────────────────────────────────────────────
HELIX_BASE_URL=https://helix.example.com/api/v1
HELIX_API_TOKEN=your-helix-bearer-token-here
HELIX_TIMEOUT=30

# ── Agent behaviour ─────────────────────────────────────────────────────────────
# How far back to look for case updates (days)
LOOKBACK_DAYS=7

# Optional: comma-separated substring to filter accounts by name.
# Leave blank to pull all accounts the token has access to.
ACCOUNT_FILTER=

# Where to write markdown output files
OUTPUT_DIR=./output

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
