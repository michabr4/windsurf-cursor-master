# Risk & Escalation Sentinel — environment configuration
# Copy to .env and fill in values. NEVER commit .env to source control.

# Root directory containing delivery-tracker/ and risk-sentinel/ run outputs
DATA_DIR=./data/runs

# Webex bot credentials (required unless --dry-run)
WEBEX_BOT_TOKEN=your-webex-bot-token-here
WEBEX_ROOM_ID=your-webex-room-id-here

# Reserved for future Helix enrichment (read-only)
HELIX_API_TOKEN=

# Agent behaviour
LOOKBACK_DAYS=7
LOG_LEVEL=INFO
