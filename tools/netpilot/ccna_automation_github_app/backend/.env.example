# Copy to backend/.env or repo-root .env (never commit .env).
# All variables are optional for basic study-hub use (flashcards, quiz, planner).

# Optional: path to exported CCNA landscape HTML (extended UI content)
SOURCE_HTML_PATH=/path/to/CCNA-Automation-GitHub-Training-Hub.html

# Optional: SQLite database file (default: ../data/ccna_study.db)
# DATABASE_PATH=../data/ccna_study.db
