# Copy to .env in this directory (never commit .env)

# SQLite database (default: data/ccna_study.db)
# DATABASE_PATH=data/ccna_study.db

# Optional HTML source for extended landscape content
# SOURCE_HTML_PATH=/path/to/CCNA-Automation-GitHub-Training-Hub.html

# Frontend (Vite)
VITE_API_BASE=http://127.0.0.1:8000

# GitHub App (https://docs.github.com/en/apps/creating-github-apps)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# PEM private key (use \n for newlines in a single line) OR a file path:
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/app.private-key.pem

# CORS (optional override)
# CORS_ORIGIN_REGEX=https?://localhost:5173

# Webex MGM daily report (send_reports.py / GitHub Actions)
WEBEX_BOT_TOKEN=
WEBEX_ACCESS_TOKEN=
OPENAI_API_KEY=
SUBSCRIBERS_FILE=subscribers.json
DRY_RUN=false
