# Copy to .env and adjust. Never commit .env.

# Local workbench server (127.0.0.1 only)
WORKBENCH_PORT=8840

# Optional: local LLM polish for drafts (off by default)
USE_LLM=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --------------------------------------------------
# Email assistant (work M365 — primary mailbox only)
# Minimal IT: MS_AUTH_MODE=graph_powershell (no tenant/client id needed)
# See docs/email/MINIMAL_IT.md
# --------------------------------------------------
MS_MAILBOX_UPN=you@example.com
MS_AUTH_MODE=graph_powershell

# Only for device_code or custom-app modes:
MS_TENANT_ID=organizations
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
MS_GRAPH_SCOPES="Mail.Read User.Read"
DIGEST_TZ=America/Los_Angeles

# Optional: email morning briefing (scripts/morning-briefing.py --email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
