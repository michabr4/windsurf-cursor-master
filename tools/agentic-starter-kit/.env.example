# Copy this file to .env and fill in only what you need.

# --------------------------------------------------
# General app settings
# --------------------------------------------------
APP_NAME=Safe Agentic Coding Template
APP_ENV=development
APP_PORT=3000

# --------------------------------------------------
# Webex sample settings
# Personal Access Tokens come from developer.webex.com
# --------------------------------------------------
WEBEX_ACCESS_TOKEN=
WEBEX_API_BASE_URL=https://webexapis.com/v1
WEBEX_DEMO_ROOM_ID=
WEBEX_MAX_PAGE_SIZE=50

# --------------------------------------------------
# CIRCUIT / Cisco Bridge sample settings
# Based on the original CIRCUIT_API.txt note
# --------------------------------------------------
BRIDGE_API_CLIENT_ID=
BRIDGE_API_CLIENT_SECRET=
BRIDGE_API_TOKEN_URL=https://id.cisco.com/oauth2/default/v1/token
BRIDGE_API_APP_KEY=
CISCO_BRAIN_USER_ID=
CISCO_CHAT_API_BASE_URL=https://chat-ai.cisco.com
AZURE_OPENAI_API_KEY=
CISCO_CHAT_MODEL=gpt-4.1
CISCO_CHAT_API_VERSION=2024-12-01-preview

# Local Ollama (OpenAI-compatible chat). Set USE_OLLAMA=1 and pull the model (ollama pull qwen2.5-coder:7b).
USE_OLLAMA=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_API_KEY=

# --------------------------------------------------
# Microsoft Graph API (Outlook, Calendar, Teams, OneDrive, SharePoint)
# Delegated login (device-code flow). No client secret required.
# Register app at https://portal.azure.com → Azure AD → App registrations
# Add a Mobile/Desktop redirect URI: https://login.microsoftonline.com/common/oauth2/nativeclient
#
# Required API permissions by module:
#   Email (outlook_action_items):  Mail.Read, User.Read
#   Calendar (graph_calendar):     Calendars.Read, Calendars.ReadWrite, User.Read
#   Teams (graph_teams):           Chat.Read, Chat.ReadWrite, Team.ReadBasic.All,
#                                  Channel.ReadBasic.All, User.Read
#   Files (graph_files):           Files.Read, Files.ReadWrite, Sites.Read.All, User.Read
# --------------------------------------------------
MS_TENANT_ID=organizations
MS_CLIENT_ID=
MS_MAILBOX_USER=
MS_OUTLOOK_MAX_MESSAGES=40

# --------------------------------------------------
# Asana task review (local CLI + tiny server)
# OAuth (recommended when PATs are blocked): Developer Console → your app → Client ID + Secret
# Register redirect URI: http://127.0.0.1:8845/oauth/callback (match ASANA_REVIEW_PORT)
# After login via http://127.0.0.1:8845/oauth/start the lines below are filled automatically.
# --------------------------------------------------
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_OAUTH_REDIRECT_URI=http://127.0.0.1:8845/oauth/callback
ASANA_ACCESS_TOKEN=
ASANA_REFRESH_TOKEN=
ASANA_TOKEN_EXPIRES_AT=
ASANA_REVIEW_PORT=8845
# Set to 1 to polish comments with local Ollama (OLLAMA_BASE_URL / OLLAMA_MODEL)
ASANA_REVIEW_USE_LLM=
# Shared secret for POST /api/asana/webhook (header X-Asana-Review-Secret). Generate a long random string.
ASANA_REVIEW_WEBHOOK_SECRET=

# --------------------------------------------------
# Teamspace MCP (Cursor) — internal git clone URL only; never commit real URL if policy forbids
# --------------------------------------------------
TEAMSPACE_MCP_REPO_URL=

# --------------------------------------------------
# Optional frontend-safe settings
# These are okay to expose to browser code if needed
# Do not put private tokens here.
# --------------------------------------------------
PUBLIC_APP_TITLE=Safe Agentic Template
PUBLIC_API_BASE_URL=http://localhost:3000