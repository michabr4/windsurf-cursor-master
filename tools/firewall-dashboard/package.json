{
  "name": "firewall-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n \"api,vite\" -c \"yellow,cyan\" \"node scripts/api-server.js\" \"vite\"",
    "api": "node scripts/api-server.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "setup-oauth": "node scripts/asana-oauth-setup.js",
    "fetch": "node scripts/parse-asana-csv.js",
    "fetch:api": "node scripts/fetch-asana-api.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "gantt-task-react": "^0.3.9",
    "lucide-react": "^0.363.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "concurrently": "^8.2.2",
    "vite": "^5.2.12"
  }
}
