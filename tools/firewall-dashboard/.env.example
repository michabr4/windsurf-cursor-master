# --- Option C: CSV export (on Cisco network) ---
# Export from Asana: project → ··· → Export → CSV → save here
ASANA_CSV_PATH=./data/asana-export.csv

# --- Option B: Direct REST API (off Cisco network only) ---
# Generate PAT at: https://app.asana.com/0/my-apps
ASANA_PAT=
# Find GID in the project URL: app.asana.com/0/<GID>/board
ASANA_PROJECT_GID=
