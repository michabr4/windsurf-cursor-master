NODE_ENV=development
PORT=3000
JWT_SECRET=replace_with_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_at_least_32_characters
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# Bootstrap-only development account (do not commit real values)
BOOTSTRAP_ADMIN_EMAIL=admin@serviceflow.local
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_dev_password

# Optional CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# Persistence mode: memory | postgres
STORAGE_MODE=memory
DATABASE_URL=postgres://serviceflow_admin:password@localhost:5432/serviceflow_sdm

# Queue mode (optional)
REDIS_URL=redis://localhost:6379
